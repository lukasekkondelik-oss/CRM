# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon / publishable klíč (veřejný, chrání ho RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API a MCP (volitelné) ---
# TAJNÝ klíč service_role / secret (Supabase → Project Settings → API Keys). Jen na serveru, nikdy s prefixem NEXT_PUBLIC_!
# Bez něj REST API (/api/v1) a MCP (/api/mcp) vrací 503; zbytek aplikace funguje normálně.
SUPABASE_SERVICE_ROLE_KEY=
